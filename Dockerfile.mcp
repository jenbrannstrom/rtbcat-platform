# RTBcat Read-Only MCP - minimal two-stage runtime
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-mcp.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-mcp.txt

FROM python:3.11-slim-bookworm AS runtime

WORKDIR /app

RUN groupadd --gid 10001 rtbcat && \
    useradd --no-create-home --uid 10001 --gid rtbcat \
      --shell /usr/sbin/nologin rtbcat

COPY --from=builder /opt/venv /opt/venv
COPY --chown=rtbcat:rtbcat mcp_server/ ./mcp_server/

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}"

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:10001

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import os, urllib.request; port = os.getenv('CATSCAN_MCP_PORT', '8010'); urllib.request.urlopen(f'http://localhost:{port}/health', timeout=5)" || exit 1

ENTRYPOINT ["sh", "-c", "exec python -m uvicorn mcp_server.server:app --host 0.0.0.0 --port ${CATSCAN_MCP_PORT:-8010}"]
