[Unit]
Description=Archive and remove expired RTBcat bidstream rows in verified batches
After=postgresql.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/HC_Volume_106446141 /var/lib/postgresql

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /usr/local/sbin/rtbcat-retain-bidstream --apply
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
TimeoutStopSec=150s
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

