[Unit]
Description=Archive and remove RTBcat PostgreSQL partitions older than the retention window
After=postgresql.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/HC_Volume_106446141 /var/lib/postgresql

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /usr/local/sbin/rtbcat-retain-postgres-partitions --apply --minimum-days 180
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
