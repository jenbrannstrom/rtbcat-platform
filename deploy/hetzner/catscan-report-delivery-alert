#!/usr/bin/env bash
# Run the report-delivery watchdog; post any alert to the Dept-3 Matrix room.
# Alert text carries dates/seat ids only — never monetary values or secrets.
#
# Install on the app host (see catscan-report-delivery-check.service):
#   /usr/local/bin/catscan-report-delivery-alert   (mode 755)
#   /etc/catscan-alerts.env                        (mode 600, root)
#     MATRIX_BASE_URL=..., MATRIX_ROOM_ID=..., MATRIX_ACCESS_TOKEN=...
#
# Optional args (e.g. --date YYYY-MM-DD) pass through to the checker.
set -u
. /etc/catscan-alerts.env

out=$(/usr/bin/docker exec -w /app -e PYTHONPATH=/app \
  -e CATSCAN_GMAIL_SEAT_IDS=6574658621,6634662463,1487810529,7942355670,8087233591 \
  rtbcat-api python3 scripts/check_report_delivery.py \
  --json-out /home/rtbcat/.catscan/report_delivery_status.json "$@" 2>&1)
rc=$?
echo "$out"

if [ "$rc" -eq 0 ]; then exit 0; fi
if [ "$rc" -eq 1 ]; then
  # Plain English + customer names instead of seat ids.
  alerts=$(echo "$out" | sed -n '/^ALERTS:/,$p' | tail -n +2 | sed \
    -e 's/6574658621/Moboost/g' \
    -e 's/6634662463/MobYoung/g' \
    -e 's/1487810529/FrontClick/g' \
    -e 's/7942355670/STARTI/g' \
    -e 's/8087233591/Uplivo/g' \
    -e 's/CANONICAL-SPEND email did not arrive on its normal day/the money report email from Google did not arrive on its normal day/' \
    -e 's/report email did not arrive on its normal day/a report email from Google did not arrive on its normal day/' \
    -e 's/no canonical spend rows in BigQuery for metric/no spend numbers on record for/' \
    -e 's/ — may still arrive late; spend-lane status is the ground truth//')
  body="Google did not send all of yesterday's report emails. If a customer's MONEY report is missing, their sheet cannot update until it is re-sent (re-run the saved report in the Authorized Buyers console, delivered by email).
$alerts"
else
  body="The report-delivery check itself failed to run (exit $rc) on the RTBcat server — check journalctl -u catscan-report-delivery-check"
fi
txn="delivery-$(date -u +%s)"
room_enc=$(python3 - "$MATRIX_ROOM_ID" <<'PY'
import sys, urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PY
)
payload=$(python3 - "$body" <<'PY'
import sys, json
print(json.dumps({"msgtype": "m.text", "body": sys.argv[1]}))
PY
)
curl -sf -X PUT \
  -H "Authorization: Bearer $MATRIX_ACCESS_TOKEN" \
  -H "Content-Type: application/json" \
  -d "$payload" \
  "$MATRIX_BASE_URL/_matrix/client/v3/rooms/$room_enc/send/m.room.message/$txn" >/dev/null \
  || echo "matrix post failed" >&2
exit "$rc"
